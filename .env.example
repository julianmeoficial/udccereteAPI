# =============================================================================
# API UDEC Cereté — Variables de entorno
# Copiar a .env y completar con valores reales. Nunca commitear secretos.
# Guía detallada: docs/operations/env.md
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Orígenes CORS separados por coma. En prod, listar el dominio público (no usar * con credenciales).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limit en memoria (proceso único). En producción irá detrás de un gateway y/o Redis.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- PostgreSQL ---
# Local (docker-compose): usuario udccerete / contraseña udccerete / base udccerete
DATABASE_URL=postgresql://udccerete:udccerete@localhost:5432/udccerete
# Supabase cloud: usar el pooler en modo transaction (puerto 6543). Ver docs/operations/migrations-supabase.md

# --- Supabase Auth ---
# Project URL del dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (recomendado) o anon key legacy — solo para proxy /auth y clientes
SUPABASE_ANON_KEY=
# Service role: SOLO workers/operaciones server-side. Nunca en clientes ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
# JWKS para validar JWT entrantes (obligatorio en producción)
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- URLs de la aplicación cliente ---
# URL pública del frontend (Next/Expo). Usada como redirect por defecto en Magic Link y Google OAuth.
SITE_URL=http://localhost:3000
# Opcional: override explícito del redirect de auth (si difiere de SITE_URL)
# AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Google OAuth se configura en Supabase Dashboard → Authentication → Providers → Google.
# No requiere variables en este archivo (Client ID/Secret van en el panel de Supabase).

# --- Redis (caché, rate limiting, colas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Typesense (búsqueda del sitio) ---
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev-typesense-key

# --- Cloudflare R2 (imágenes, PDF, adjuntos — API compatible S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=udccerete-assets
R2_PUBLIC_URL=

# --- Correo ---
# Resend: configurar como SMTP en Supabase Dashboard para Magic Link en producción.
# La API usa RESEND_API_KEY solo para notificaciones propias (no para login).
RESEND_API_KEY=

# --- IA (Perplexity Sonar — con caché y límites) ---
PERPLEXITY_API_KEY=

# --- Observabilidad ---
SENTRY_DSN=

# --- Push notifications (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@udccerete.edu.co

# --- Push móvil (futuro) ---
FCM_SERVER_KEY=
APNS_KEY_ID=
HMS_APP_ID=
