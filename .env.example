# =============================================================================
# API UDEC Cereté — Variables de entorno
# Copiar a .env y completar con valores reales. Nunca commitear secretos.
# =============================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Orígenes CORS separados por coma. En prod, listar el dominio público (no usar * con credenciales).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limit en memoria (proceso único). En producción irá detrás de un gateway y/o Redis.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- PostgreSQL (Supabase en producción; Postgres local vía docker-compose) ---
DATABASE_URL=postgresql://udccerete:udccerete@localhost:5432/udccerete

# --- Supabase Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# --- Redis (caché, rate limiting, colas BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Typesense (búsqueda del sitio) ---
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# --- Cloudflare R2 (imágenes, PDF, adjuntos — API compatible S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=udccerete-assets
R2_PUBLIC_URL=

# --- Correo (Resend vía Supabase SMTP) ---
RESEND_API_KEY=

# --- IA (Perplexity Sonar — con caché y límites) ---
PERPLEXITY_API_KEY=

# --- Observabilidad ---
SENTRY_DSN=

# --- Push notifications (Web Push / VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@udccerete.edu.co
SITE_URL=http://localhost:3000

# --- Push móvil (futuro) ---
FCM_SERVER_KEY=
APNS_KEY_ID=
HMS_APP_ID=
